{
  "name": "autoscroll",
  "version": "1.0.0",
  "description": "Browser extension for Chrome and Firefox that scrolls the current page toward the bottom. Click the toolbar icon to start; scroll up or click again to stop.",
  "main": "index.js",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyhope/autoscroll.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dannyhope/autoscroll/issues"
  },
  "homepage": "https://github.com/dannyhope/autoscroll#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
