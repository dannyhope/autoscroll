{
	"manifest_version": 3,
	"name": "Autoscroll",
	"description": "Scroll to the bottom of the page. Click the toolbar icon; scroll up to stop.",
	"version": "0.3",
	"author": "Danny Hope",
	"homepage_url": "https://dannyhope.co.uk",
	"action": {
		"default_title": "Autoscroll",
		"default_icon": {
			"16": "icon-16.png",
			"48": "icon-48.png",
			"128": "icon-128.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"16": "icon-16.png",
		"48": "icon-48.png",
		"128": "icon-128.png"
	},
	"permissions": [
		"activeTab",
		"scripting"
	]
}
